workflows:
  azkary-android:
    name: Azkary Android APK
    max_build_duration: 60

    scripts:
      - name: Extract project
        script: |
          rm -rf "$CM_BUILD_DIR/project"
          mkdir -p "$CM_BUILD_DIR/project"
          unzip -q "$CM_BUILD_DIR/Azkary-Final-Android-Project.zip" -d "$CM_BUILD_DIR/project"

      - name: Create Gradle wrapper
        script: |
          cd "$CM_BUILD_DIR/project"
          gradle wrapper --gradle-version 8.7

      - name: Build APK
        script: |
          cd "$CM_BUILD_DIR/project"
          ./gradlew assembleDebug

    artifacts:
      - project/app/build/outputs/apk/debug/app-debug.apk
